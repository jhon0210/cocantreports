# Copia este archivo a .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# Conexión a PostgreSQL (base de datos reportesbd)
DATABASE_URL="postgresql://postgres:CAMBIAR_CLAVE@localhost:5432/reportesbd?schema=public"

# Secretos JWT: deben ser distintos entre sí y tener al menos 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-por-uno-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh-por-otro-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
# Duración del refresh token en días
JWT_REFRESH_EXPIRES_DAYS=7

# Costo de bcrypt (10-14)
BCRYPT_ROUNDS=12

# Origen(es) permitidos por CORS, separados por coma (el frontend de Vite usa 5173)
CORS_ORIGINS=http://localhost:5173

# Cookie del refresh token
# SameSite=strict funciona cuando frontend y backend comparten "site" (p. ej. localhost:5173 y localhost:3000).
# Si se despliegan en dominios distintos usa none (requiere HTTPS y COOKIE_SECURE=true).
COOKIE_SAMESITE=strict
COOKIE_SECURE=false

# Zona horaria usada para FechaRegistro y para validar FechaVenta
APP_TIMEZONE=America/Bogota

# Local: BD. Staging Lambda: s3, bucket privado y rol IAM (sin claves en archivos).
# Aplicar primero la migracion archivos_s3 a la base del entorno autorizado.
FILE_STORAGE=bd
# AWS_REGION=us-east-1
# S3_FILES_BUCKET=nombre-del-bucket-privado
# S3_ENDPOINT solo para pruebas locales; se rechaza en NODE_ENV=production.
# En Lambda se inyecta APP_SECRET_ARN (solo ARN, no valores) mediante Terraform.
# La API obtiene DATABASE_URL/JWT desde Secrets Manager antes de importar Nest.
# El ejecutor de esquema usa otro secreto con MIGRATION_DATABASE_URL.
