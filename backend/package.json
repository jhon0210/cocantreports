{
    "name": "cocjant-backend",
    "version": "1.0.0",
    "description": "API de reportes de ventas de material de aprovechamiento (NestJS + Prisma + PostgreSQL)",
    "private": true,
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main.js",
        "prisma:generate": "prisma generate",
        "migrate": "prisma migrate deploy",
    "migrate:baseline": "prisma migrate resolve --applied 20260101000000_baseline",
        "migrate:dev": "prisma migrate dev",
        "migrate:status": "prisma migrate status",
        "seed": "tsx seeders/seed.ts",
        "test": "jest",
        "test:e2e": "jest --config test/jest-e2e.json --runInBand"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node"
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "3.1159.0",
        "@aws-sdk/client-s3": "3.1159.0",
        "@aws-sdk/s3-presigned-post": "3.1159.0",
        "@aws-sdk/s3-request-presigner": "3.1159.0",
        "@codegenie/serverless-express": "4.17.1",
        "@nestjs/common": "^11.1.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.1.0",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.0",
        "@nestjs/platform-express": "^11.1.0",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/throttler": "^6.7.1",
        "@prisma/client": "^6.19.3",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^18.0.7",
        "helmet": "^8.3.0",
        "joi": "^18.2.9",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@types/aws-lambda": "8.10.164",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/testing": "^11.1.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^7.2.1",
        "jest": "^30.5.2",
        "prisma": "^6.19.3",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.0",
        "tsx": "^4.23.15",
        "typescript": "~5.9.0"
    },
    "overrides": {
        "@nestjs/platform-express": {
            "multer": "2.5.0"
        },
        "@nestjs/swagger": {
            "js-yaml": "5.5.0"
        },
        "@prisma/config@6.19.3": {
            "deepmerge-ts": "8.0.2"
        }
    },
    "allowScripts": {
        "prisma@6.19.3": true,
        "@prisma/engines@6.19.3": true,
        "@prisma/client@6.19.3": true,
        "esbuild@0.28.2": true
    }
}
